rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== Helper Functions =====
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user owns the resource
    function isOwner(ownerId) {
      return isAuthenticated() && request.auth.uid == ownerId;
    }
    
    // Check user role
    function hasRole(role) {
      return isAuthenticated() && 
             request.auth.token.role == role;
    }
    
    // Check if user is admin or moderator
    function isAdminOrModerator() {
      return hasRole('admin') || hasRole('moderator');
    }
    
    // Check if user is admin
    function isAdmin() {
      return hasRole('admin');
    }
    
    // Check if listing status is public
    function isPublicListing(status) {
      return status == 'active';
    }
    
    // Validate listing data
    function isValidListingData(data) {
      return data.keys().hasAll(['title', 'category', 'brand', 'price', 'ownerId']) &&
             data.title is string && data.title.size() >= 10 && data.title.size() <= 100 &&
             data.category in ['tire', 'rim', 'complete_set', 'accessories'] &&
             data.price is number && data.price >= 100 && data.price <= 2000000 &&
             data.ownerId is string;
    }
    
    // Validate user data
    function isValidUserData(data) {
      return data.keys().hasAll(['displayName', 'email', 'phoneNumber', 'wilaya']) &&
             data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 50 &&
             data.email is string && data.email.matches('.*@.*\\..*') &&
             data.phoneNumber is string && data.phoneNumber.matches('\\+213[5-7]\\d{8}') &&
             data.wilaya is string && data.wilaya.size() > 0;
    }
    
    // ===== Users Collection =====
    
    match /users/{userId} {
      // Read: Allow authenticated users to read profiles, admins can read all
      allow read: if isAuthenticated() || isAdminOrModerator();
      
      // Create: Allow users to create their own profile with validation
      allow create: if isOwner(userId) && 
                       isValidUserData(request.resource.data) &&
                       request.resource.data.role == 'user' && // New users start as 'user'
                       request.resource.data.accountStatus == 'active';
      
      // Update: Allow users to update their own profile, admins can update any
      allow update: if (isOwner(userId) && 
                        isValidUserData(request.resource.data) &&
                        // Users can't change their own role or status
                        request.resource.data.role == resource.data.role &&
                        request.resource.data.accountStatus == resource.data.accountStatus) ||
                       // Admins and moderators can update roles and status
                       isAdminOrModerator();
      
      // Delete: Only admins can delete users
      allow delete: if isAdmin();
    }
    
    // ===== Listings Collection =====
    
    match /listings/{listingId} {
      // Read: Public listings for everyone, own listings for owners, all for admins
      allow read: if isPublicListing(resource.data.status) ||
                     isOwner(resource.data.ownerId) ||
                     isAdminOrModerator();
      
      // Create: Authenticated users can create valid listings
      allow create: if isAuthenticated() &&
                       isOwner(request.resource.data.ownerId) &&
                       isValidListingData(request.resource.data) &&
                       request.resource.data.status in ['active', 'pending'];
      
      // Update: Owners can update their listings, moderators can approve/reject
      allow update: if (isOwner(resource.data.ownerId) && 
                        // Owners can't change ownerId or approval status
                        request.resource.data.ownerId == resource.data.ownerId) ||
                       // Moderators can approve/reject and change status
                       isAdminOrModerator() ||
                       // Allow view counter increment by anyone
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'contactClicks', 'favorites', 'shareCount', 'updatedAt']));
      
      // Delete: Owners can delete their listings, moderators can delete any
      allow delete: if isOwner(resource.data.ownerId) || isAdminOrModerator();
    }
    
    // ===== Messages Collection =====
    
    match /messages/{messageId} {
      // Read: Sender and receiver can read their messages, moderators can read all
      allow read: if isOwner(resource.data.senderId) ||
                     isOwner(resource.data.receiverId) ||
                     isAdminOrModerator();
      
      // Create: Authenticated users can send messages
      allow create: if isAuthenticated() &&
                       isOwner(request.resource.data.senderId) &&
                       request.resource.data.content is string &&
                       request.resource.data.content.size() >= 1 &&
                       request.resource.data.content.size() <= 1000;
      
      // Update: Sender can mark as read, moderators can moderate
      allow update: if isOwner(resource.data.receiverId) ||
                       isAdminOrModerator();
      
      // Delete: Moderators only
      allow delete: if isAdminOrModerator();
    }
    
    // ===== Conversations Collection =====
    
    match /conversations/{conversationId} {
      // Read: Participants can read their conversations, moderators can read all
      allow read: if isAuthenticated() &&
                     (request.auth.uid in resource.data.participants ||
                      isAdminOrModerator());
      
      // Create/Update: Participants can create and update conversations
      allow create, update: if isAuthenticated() &&
                               request.auth.uid in request.resource.data.participants;
      
      // Delete: Admins only
      allow delete: if isAdmin();
    }
    
    // ===== Favorites Collection =====
    
    match /favorites/{favoriteId} {
      // Read: Users can read their own favorites, admins can read all
      allow read: if isOwner(resource.data.userId) || isAdminOrModerator();
      
      // Create: Users can create their own favorites
      allow create: if isAuthenticated() &&
                       isOwner(request.resource.data.userId);
      
      // Update: Users can update their own favorites
      allow update: if isOwner(resource.data.userId);
      
      // Delete: Users can delete their own favorites, admins can delete any
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
    
    // ===== Searches Collection =====
    
    match /searches/{searchId} {
      // Read: Users can read their own searches, admins can read all
      allow read: if resource.data.userId == null || // Anonymous searches
                     isOwner(resource.data.userId) || 
                     isAdminOrModerator();
      
      // Create: Anyone can create searches (including anonymous)
      allow create: if request.resource.data.userId == null ||
                       isOwner(request.resource.data.userId);
      
      // Update: Users can update their own searches
      allow update: if isOwner(resource.data.userId);
      
      // Delete: Users can delete their own searches, admins can delete any
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
    
    // ===== Statistics Collections =====
    
    match /daily-stats/{date} {
      // Read: Moderators and admins only
      allow read: if isAdminOrModerator();
      
      // Create/Update: System only (server-side)
      allow create, update: if false;
      
      // Delete: Admins only
      allow delete: if isAdmin();
    }
    
    match /stats/{document} {
      // Read: Basic stats for everyone, detailed for moderators
      allow read: if document == 'platform-summary' || isAdminOrModerator();
      
      // Create/Update: System only
      allow create, update: if false;
      
      // Delete: Admins only
      allow delete: if isAdmin();
    }
    
    match /category-stats/{categoryId} {
      // Read: Everyone can read category stats
      allow read: if true;
      
      // Create/Update/Delete: System only
      allow create, update, delete: if false;
    }
    
    match /wilaya-stats/{wilayaId} {
      // Read: Everyone can read wilaya stats
      allow read: if true;
      
      // Create/Update/Delete: System only
      allow create, update, delete: if false;
    }
    
    // ===== Admin Collections =====
    
    match /user-activities/{activityId} {
      // Read: Admins and moderators only
      allow read: if isAdminOrModerator();
      
      // Create: System and admins
      allow create: if isAdminOrModerator();
      
      // Update/Delete: Admins only
      allow update, delete: if isAdmin();
    }
    
    match /system-logs/{logId} {
      // Read: Admins only
      allow read: if isAdmin();
      
      // Create: System and admins
      allow create: if isAdmin();
      
      // Update/Delete: Admins only
      allow update, delete: if isAdmin();
    }
    
    // ===== Default Deny Rule =====
    
    // Deny access to any other collections not explicitly defined
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

/*
===== Firestore Security Rules Summary =====

1. User Roles:
   - user: Basic authenticated user
   - moderator: Can moderate content and view detailed stats
   - admin: Full system access

2. Access Patterns:
   - Users: Own data + public data
   - Moderators: All content for moderation + detailed stats
   - Admins: Full access to everything

3. Validation Rules:
   - User data: Name, email, phone validation
   - Listing data: Title length, category, price range validation
   - Message data: Content length validation

4. Key Security Features:
   - Role-based access control
   - Data validation at write time
   - Prevent privilege escalation
   - Audit trail for admin actions

5. Collections Overview:
   - users: User profiles and account data
   - listings: Product listings with moderation
   - messages/conversations: Private messaging system
   - favorites: User favorites with privacy
   - searches: Search history (anonymous allowed)
   - *-stats: Statistics (read-only, system generated)
   - user-activities: Admin audit logs
   - system-logs: System event logs

===== Deployment Instructions =====

1. Copy this entire content
2. Go to Firebase Console → Firestore Database → Rules
3. Replace existing rules with this content
4. Click "Publish"
5. Test with Firebase Rules Playground

===== Testing Checklist =====

□ User can create/read/update own profile
□ User cannot change own role/status
□ Admin can update any user's role/status
□ User can create/read/update/delete own listings
□ Moderator can approve/reject any listing
□ Anonymous users can read public listings
□ Message privacy between sender/receiver
□ Favorites privacy per user
□ Anonymous searches allowed
□ Stats access based on role
□ Admin audit trails protected

*/