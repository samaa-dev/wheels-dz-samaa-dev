rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== Helper Functions =====
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(ownerId) {
      return isAuthenticated() && request.auth.uid == ownerId;
    }
    
    // Legacy custom claims (optional; app stores role on user doc)
    function hasRole(role) {
      return isAuthenticated() && 
             request.auth.token.role == role;
    }
    
    function isAdminOrModerator() {
      return hasRole('admin') || hasRole('moderator');
    }
    
    function isAdmin() {
      return hasRole('admin');
    }

    // Role from Firestore user doc (primary source of truth in this app)
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isModeratorOrAdminDoc() {
      return isAuthenticated() && userRole() in ['admin', 'moderator'];
    }

    function isAdminDoc() {
      return isAuthenticated() && userRole() == 'admin';
    }

    // Claims OR Firestore doc role
    function isStaff() {
      return isAdminOrModerator() || isModeratorOrAdminDoc();
    }

    function isAdminStaff() {
      return isAdmin() || isAdminDoc();
    }
    
    function isPublicListing(status) {
      return status == 'active';
    }
    
    // Validate listing data (price may be 0 — UI no longer collects price)
    function isValidListingData(data) {
      return data.keys().hasAll(['title', 'category', 'brand', 'price', 'ownerId']) &&
             data.title is string && data.title.size() >= 5 && data.title.size() <= 100 &&
             data.category in ['tire', 'rim', 'complete_set', 'accessories'] &&
             data.brand is string &&
             data.price is number && data.price >= 0 && data.price <= 2000000 &&
             data.ownerId is string;
    }
    
    // Validate user data — allow incomplete Google signup (profileComplete == false)
    function isValidUserData(data) {
      return data.keys().hasAll(['displayName', 'email', 'phoneNumber', 'wilaya']) &&
             data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 50 &&
             data.email is string && data.email.matches('.*@.*\\..*') &&
             data.phoneNumber is string &&
             data.wilaya is string &&
             (
               data.profileComplete == false ||
               (
                 data.phoneNumber.matches('\\+213[5-7]\\d{8}') &&
                 data.wilaya.size() > 0 &&
                 data.accountType in ['buyer', 'seller_individual', 'seller_merchant']
               )
             );
    }
    
    // ===== Users Collection =====
    
    match /users/{userId} {
      allow read: if isAuthenticated() || isStaff();
      
      allow create: if isOwner(userId) && 
                       isValidUserData(request.resource.data) &&
                       request.resource.data.role == 'user' &&
                       request.resource.data.accountStatus == 'active';
      
      allow update: if (isOwner(userId) && 
                        isValidUserData(request.resource.data) &&
                        request.resource.data.role == resource.data.role &&
                        request.resource.data.accountStatus == resource.data.accountStatus) ||
                       isStaff();
      
      allow delete: if isAdminStaff();
    }
    
    // ===== Listings Collection =====
    
    match /listings/{listingId} {
      allow read: if isPublicListing(resource.data.status) ||
                     isOwner(resource.data.ownerId) ||
                     isStaff();
      
      allow create: if isAuthenticated() &&
                       isOwner(request.resource.data.ownerId) &&
                       isValidListingData(request.resource.data) &&
                       request.resource.data.status in ['active', 'pending'];
      
      // Owners may edit content / toggle active↔inactive; only staff can approve pending→active
      allow update: if (isOwner(resource.data.ownerId) && 
                        request.resource.data.ownerId == resource.data.ownerId &&
                        (
                          request.resource.data.status == resource.data.status ||
                          (resource.data.status in ['active', 'inactive', 'sold', 'reserved'] &&
                           request.resource.data.status in ['active', 'inactive', 'sold', 'reserved', 'deleted'])
                        )) ||
                       isStaff() ||
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'contactClicks', 'favorites', 'shareCount', 'updatedAt']));
      
      allow delete: if isOwner(resource.data.ownerId) || isStaff();
    }
    
    // ===== Messages Collection =====
    
    match /messages/{messageId} {
      allow read: if isOwner(resource.data.senderId) ||
                     isOwner(resource.data.receiverId) ||
                     isStaff();
      
      allow create: if isAuthenticated() &&
                       isOwner(request.resource.data.senderId) &&
                       request.resource.data.content is string &&
                       request.resource.data.content.size() >= 1 &&
                       request.resource.data.content.size() <= 1000;
      
      allow update: if isOwner(resource.data.receiverId) ||
                       isStaff();
      
      allow delete: if isStaff();
    }
    
    // ===== Conversations Collection =====
    
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() &&
                     (request.auth.uid in resource.data.participants ||
                      isStaff());
      
      allow create, update: if isAuthenticated() &&
                               request.auth.uid in request.resource.data.participants;
      
      allow delete: if isAdminStaff();
    }
    
    // ===== Reviews Collection =====

    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' ||
                     isOwner(resource.data.reviewerId) ||
                     isStaff();

      allow create: if isAuthenticated() &&
                       isOwner(request.resource.data.reviewerId) &&
                       request.resource.data.sellerId is string &&
                       request.resource.data.sellerId != request.auth.uid &&
                       request.resource.data.rating is number &&
                       request.resource.data.rating >= 1 &&
                       request.resource.data.rating <= 5 &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.comment is string &&
                       request.resource.data.comment.size() <= 500;

      allow update: if isStaff() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isAdminStaff() || isModeratorOrAdminDoc();
    }
    
    // ===== Favorites Collection =====
    
    match /favorites/{favoriteId} {
      allow read: if isOwner(resource.data.userId) || isStaff();
      
      allow create: if isAuthenticated() &&
                       isOwner(request.resource.data.userId);
      
      allow update: if isOwner(resource.data.userId);
      
      allow delete: if isOwner(resource.data.userId) || isAdminStaff();
    }
    
    // ===== Searches Collection =====
    
    match /searches/{searchId} {
      allow read: if resource.data.userId == null ||
                     isOwner(resource.data.userId) || 
                     isStaff();
      
      allow create: if request.resource.data.userId == null ||
                       isOwner(request.resource.data.userId);
      
      allow update: if isOwner(resource.data.userId);
      
      allow delete: if isOwner(resource.data.userId) || isAdminStaff();
    }
    
    // ===== Statistics Collections =====
    
    match /daily-stats/{date} {
      allow read: if isStaff();
      allow create, update: if false;
      allow delete: if isAdminStaff();
    }
    
    match /stats/{document} {
      allow read: if document == 'platform-summary' || isStaff();
      allow create, update: if false;
      allow delete: if isAdminStaff();
    }
    
    match /category-stats/{categoryId} {
      allow read: if true;
      allow create, update, delete: if false;
    }
    
    match /wilaya-stats/{wilayaId} {
      allow read: if true;
      allow create, update, delete: if false;
    }
    
    // ===== Admin Collections =====
    
    match /user-activities/{activityId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isAdminStaff();
    }
    
    match /system-logs/{logId} {
      allow read: if isAdminStaff();
      allow create: if isAdminStaff();
      allow update, delete: if isAdminStaff();
    }
    
    // ===== Default Deny Rule =====
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
